    "@types/jasmine": "~5.1.0",
    "concurrently": "^8.0.0",
    "jasmine-core": "~5.1.0",
    "json-server": "^0.17.4",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "puppeteer": "^24.40.0",
    "typescript": "~5.4.2"
  },
  "author": "Nixon",
  "overrides": {
    "piscina": "4.9.4",
    "proxy-addr": "2.0.8",
